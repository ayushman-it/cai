# CuboidPilot Environment Configuration Template
APP_ENV=production
APP_DEBUG=false

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=cuboidpolit_db

# Groq AI Engine Key (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Multi-Tenant Symmetric AES-256 Encryption Key (Generate a random 32+ char hex string)
CP_ENCRYPTION_KEY=replace_with_a_secure_random_32_byte_secret_key

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=
